+    parts = [f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="5" fill="{fill}" stroke="{stroke}" stroke-width="2"{dash}/>']
+    line_height = size + 5
+    start = y + h / 2 - (len(lines) - 1) * line_height / 2 + size * 0.35
+    for index, line in enumerate(lines):
