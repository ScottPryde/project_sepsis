+
+def _render_methodology(
+    config: dict[str, Any],
+    cohort: dict[str, Any],
+    evaluation: dict[str, Any],
+    features: pd.DataFrame | None,
+) -> str:
+    if not config:
+        return ""
+    specs = config.get("model_specs", {})
+    n_features = features.shape[1] if features is not None else len(KNOWN_CLINICAL_COLUMNS) * 8
+    exclusions = cohort.get("exclusions", {})
+    excluded_text = ", ".join(f"{v} {k.replace('_', ' ')}" for k, v in exclusions.items()) or "none recorded"
+    model_rows = "".join(
+        "<tr>"
+        f'<td><span class="swatch" style="background:{model_color(name)}"></span>{html.escape(model_label(name))}</td>'
+        f'<td>{html.escape(spec.get("input", "—"))}</td>'
+        f'<td>{html.escape("; ".join(spec.get("preprocessing", [])))}</td>'
+        f'<td style="white-space:normal;min-width:260px">{html.escape(spec.get("estimator", "—"))}</td>'
+        f'<td>{html.escape(spec.get("class_weighting", "—"))}</td>'
+        "</tr>"
+        for name, spec in specs.items()
+    )
+    target = float(evaluation.get("target_sensitivity", 0.8)) if evaluation else 0.8
+    return f'''<section><h2>Methodology</h2><div class="method-grid prose">
+<div><h3>Data and cohort</h3>
+<p>Source data are hourly ICU records from the PhysioNet/Computing in Cardiology Challenge 2019, one pipe-separated file per patient. Rows are read in file order as consecutive ICU hours.</p>
+<p>Each patient contributes one prediction made at the end of hour 5. Inputs are rows 0–5 only. The outcome is any positive SepsisLabel from row 6 onward. In this dataset the label is already shifted to switch on six hours before the Sepsis-3 onset time, so a positive outcome corresponds to onset at roughly hour 12 or later, and patients with earlier onset are excluded as already labelled in the look-back.</p>
+<p>Eligible patients: {html.escape(str(cohort.get("eligible_patients", "—")))}, of whom {html.escape(str(cohort.get("positive_outcomes", "—")))} have a positive outcome. Excluded: {html.escape(excluded_text)}.</p>
+<p>The outcome window runs to the end of each record, so it is longer for patients who stay longer. See the improvement plan for a fixed-horizon alternative.</p></div>
+<div><h3>Features and representations</h3>
+<p>Tabular models receive {n_features} engineered features: for each of {len(KNOWN_CLINICAL_COLUMNS)} clinical and demographic variables, the latest observed value, mean, minimum, maximum, standard deviation, first-to-last change, fraction of hours missing, and an any-missing flag.</p>
+<p>The 1D CNN receives the same six hours as an ordered hours × variables tensor without summary statistics or missingness flags. A difference between the CNN and the tabular models therefore reflects both the representation and the model family.</p>
+<p>SepsisLabel, the patient identifier and ICULOS are never inputs.</p></div>
+<div><h3>Splitting and preprocessing</h3>
+<p>Patients are split once into training ({html.escape(str(config.get("n_train", "—")))}) and held-out test ({html.escape(str(config.get("n_test", "—")))}) groups with seed {html.escape(str(config.get("random_state", "—")))} and test fraction {html.escape(str(config.get("test_size", "—")))}. Every model is scored on the same test patients.</p>
+<p>Imputation and scaling are learned from training patients only and then applied unchanged to test patients. No hyperparameters were tuned, and no validation split was used.</p></div>
+<div><h3>Evaluation</h3>
+<p>Models are ranked by AUPRC, with AUROC as a tie-break. Uncertainty comes from {html.escape(str(evaluation.get("n_bootstrap", 1000)))} paired bootstrap resamples of the test patients. A model is called worse than the top model only when the 95% interval of the AUPRC difference excludes zero.</p>
+<p>To compare alert burden fairly, each model is also read at the threshold that reaches {target:.0%} sensitivity, reporting specificity, PPV and alerts per 100 patients. Calibration is summarised by the logistic calibration slope and a 10-bin calibration curve, and clinical utility by decision-curve net benefit across alert thresholds from 1% to 50%.</p></div>
+</div>
+<h3 style="margin-top:12px">Models compared</h3><div class="table-wrap"><table><thead><tr><th>Model</th><th>Input</th><th>Preprocessing</th><th>Estimator</th><th>Class weighting</th></tr></thead><tbody>{model_rows}</tbody></table></div>
