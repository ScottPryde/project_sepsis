+def _flat_table(rows: list[dict[str, Any]]) -> pd.DataFrame:
+    flat = []
+    for row in rows:
+        op = row["operating_point"]
+        cal = row["calibration"]
+        flat.append({
+            "rank": row["rank"],
+            "model": row["model"],
+            "auprc": row["auprc"],
+            "auprc_ci_low": row["auprc_ci"][0],
+            "auprc_ci_high": row["auprc_ci"][1],
+            "auroc": row["auroc"],
+            "auroc_ci_low": row["auroc_ci"][0],
+            "auroc_ci_high": row["auroc_ci"][1],
+            "brier": row["brier"],
+            "calibration_slope": cal["calibration_slope"],
+            "ece_10_bin": cal["ece_10_bin"],
+            "op_threshold": op.get("threshold"),
+            "op_specificity": op.get("specificity"),
+            "op_ppv": op.get("ppv"),
+            "op_alerts_per_100": op.get("alerts_per_100"),
+            "op_alerts_per_true_case": op.get("alerts_per_true_case"),
+        })
+    return pd.DataFrame(flat)
+
+
+def _plot_calibration(output: Path, y: np.ndarray, probs: dict[str, np.ndarray]) -> None:
+    figure, axis = plt.subplots(figsize=(5.6, 4.6))
+    axis.plot([0, 1], [0, 1], color="#777777", linestyle="--", linewidth=1, label="Perfect calibration")
+    for name, p in probs.items():
+        quantiles = np.unique(np.quantile(p, np.linspace(0, 1, 11)))
+        if quantiles.size < 2:
+            continue
+        bins = np.clip(np.digitize(p, quantiles[1:-1]), 0, quantiles.size - 2)
+        xs, ys = [], []
+        for b in range(quantiles.size - 1):
+            mask = bins == b
+            if mask.sum() >= 1:
+                xs.append(p[mask].mean())
+                ys.append(y[mask].mean())
+        axis.plot(xs, ys, marker="o", markersize=4, linewidth=1.6, color=model_color(name), label=model_label(name))
+    axis.set(xlim=(0, 1), ylim=(0, 1), xlabel="Mean predicted risk (decile)", ylabel="Observed sepsis rate",
+             title="Calibration")
+    axis.legend(frameon=False, fontsize=8, loc="upper left")
+    figure.tight_layout()
+    figure.savefig(output / "calibration.png", dpi=160)
+    plt.close(figure)
+
+
+def _plot_decision_curve(output: Path, decision: dict[str, Any]) -> None:
+    thresholds = np.asarray(decision["thresholds"])
+    figure, axis = plt.subplots(figsize=(5.6, 4.6))
+    axis.plot(thresholds, decision["treat_all"], color="#999999", linewidth=1.2, label="Alert everyone")
+    axis.axhline(0, color="#444444", linewidth=1, label="Alert no one")
+    top = 0.0
+    for name, values in decision["models"].items():
+        axis.plot(thresholds, values, linewidth=1.8, color=model_color(name), label=model_label(name))
+        top = max(top, max(values))
+    top = max(top, max(decision["treat_all"]), 0.01)
+    axis.set(xlim=(0, thresholds.max()), ylim=(-top * 0.25, top * 1.15), xlabel="Risk threshold for alerting",
+             ylabel="Net benefit", title="Decision curve")
+    axis.legend(frameon=False, fontsize=8)
+    figure.tight_layout()
+    figure.savefig(output / "decision_curve.png", dpi=160)
+    plt.close(figure)
+
+
+def _plot_forest(output: Path, rows: list[dict[str, Any]]) -> None:
+    figure, axes = plt.subplots(1, 2, figsize=(10, 0.6 * max(len(rows), 2) + 1.6), sharey=True)
+    labels = [model_label(r["model"]) for r in rows][::-1]
+    for axis, key, title in ((axes[0], "auprc", "AUPRC (95% CI)"), (axes[1], "auroc", "AUROC (95% CI)")):
+        for position, row in enumerate(rows[::-1]):
+            value = row[key]
+            low, high = row[f"{key}_ci"]
+            if value is None:
+                continue
+            color = model_color(row["model"])
+            if low is not None and high is not None:
+                axis.plot([low, high], [position, position], color=color, linewidth=2.4)
+            axis.plot(value, position, "o", color=color, markersize=7)
+        axis.set_title(title, fontsize=11)
+        axis.set_xlim(0, 1)
+        axis.grid(axis="x", color="#e3e7e4")
+    axes[0].set_yticks(range(len(labels)), labels)
+    figure.tight_layout()
+    figure.savefig(output / "model_forest.png", dpi=160)
+    plt.close(figure)
