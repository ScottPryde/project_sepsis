+            f'<td>{_fmt(row["brier"])}</td>'
+            f'<td>{_fmt(cal.get("calibration_slope"), 2)}</td>'
+            f'<td>{_fmt(op.get("specificity"))}</td>'
+            f'<td>{_fmt(op.get("ppv"))}</td>'
+            f'<td>{_fmt(op.get("alerts_per_100"), 1)}</td>'
+            f'<td>{_fmt(op.get("alerts_per_true_case"), 1)}</td>'
+            f"<td>{html.escape(versus)}</td>"
+            "</tr>"
+        )
+    table = ('<h3>Head-to-head ranking</h3><div class="table-wrap"><table class="rank-table">'
+             f"<thead>{header}</thead><tbody>{''.join(body)}</tbody></table></div>"
+             f'<p class="diagram-label">Ranked by AUPRC, the more informative discrimination metric when sepsis is rare; '
+             f'AUROC breaks ties. Intervals are paired percentile bootstraps over the same test patients '
+             f'({evaluation.get("n_bootstrap", "—")} resamples). Operating-point columns use, for each model, the highest '
+             f'threshold reaching {target:.0%} sensitivity on these test patients, so models are compared at matched sensitivity; '
+             'because that threshold is chosen on the test set it describes the models rather than predicting deployed performance. '
+             'A calibration slope near 1 means predicted risks are neither over- nor under-confident.</p>')
